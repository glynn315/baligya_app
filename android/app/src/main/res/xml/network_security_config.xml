<?xml version="1.0" encoding="utf-8"?>
<!--
  Allow cleartext HTTP for development against the local Laravel server.
  Tighten this for production builds (HTTPS only).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
